# Copy to .env, fill in one key, and load it before starting the server
# (for example: export $(grep -v '^#' .env | xargs)).

# Which model reads the pages. Any litellm provider string works.
PRICE_COMPARE_LLM_PROVIDER=gemini/gemini-3.5-flash-lite

# The first of these that is set is used.
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# PRICE_COMPARE_LLM_API_KEY=

# Optional
# PRICE_COMPARE_INPUT_FORMAT=markdown   # or "html" if names and prices get mixed up
# PRICE_COMPARE_CACHE_TTL=600           # seconds a repeated search reuses its result
# PRICE_COMPARE_DB=price_compare.db     # where search history is saved
# PRICE_COMPARE_LOG_LEVEL=INFO          # DEBUG shows every match decision
